{
  "name": "paredit-redex",
  "displayName": "Paredit for Racket",
  "description": "Structural editing (paredit) for Racket, Scheme and Lisp — slurp, barf, splice, raise, wrap, with the canonical Emacs keymap.",
  "version": "0.1.0",
  "publisher": "KaiErikNiermann",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaiErikNiermann/paredit-redex.git"
  },
  "bugs": {
    "url": "https://github.com/KaiErikNiermann/paredit-redex/issues"
  },
  "homepage": "https://github.com/KaiErikNiermann/paredit-redex#readme",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Keymaps"
  ],
  "keywords": [
    "racket",
    "paredit",
    "scheme",
    "lisp",
    "structural editing"
  ],
  "activationEvents": [
    "onLanguage:racket",
    "onLanguage:scheme",
    "onLanguage:lisp",
    "onLanguage:commonlisp"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "paredit-redex.forwardSexp",
        "title": "Forward Sexp",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.backwardSexp",
        "title": "Backward Sexp",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.backwardUpSexp",
        "title": "Backward Up Sexp",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.forwardUpSexp",
        "title": "Forward Up Sexp",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.forwardDownSexp",
        "title": "Forward Down Sexp",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.backwardDownSexp",
        "title": "Backward Down Sexp",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.forwardSlurp",
        "title": "Forward Slurp",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.forwardBarf",
        "title": "Forward Barf",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.backwardSlurp",
        "title": "Backward Slurp",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.backwardBarf",
        "title": "Backward Barf",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.splice",
        "title": "Splice Sexp",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.raise",
        "title": "Raise Sexp",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.wrapRound",
        "title": "Wrap Round",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.wrapSquare",
        "title": "Wrap Square",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.wrapCurly",
        "title": "Wrap Curly",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.killSexp",
        "title": "Kill Sexp",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.backwardKillSexp",
        "title": "Backward Kill Sexp",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.spliceKillingBackward",
        "title": "Splice Killing Backward",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.spliceKillingForward",
        "title": "Splice Killing Forward",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.splitSexp",
        "title": "Split Sexp",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.joinSexps",
        "title": "Join Sexps",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.transposeSexps",
        "title": "Transpose Sexps",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.dragForward",
        "title": "Drag Sexp Forward",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.dragBackward",
        "title": "Drag Sexp Backward",
        "category": "Paredit"
      },
      {
        "command": "paredit-redex.cheatSheet",
        "title": "Cheat Sheet",
        "category": "Paredit"
      }
    ],
    "keybindings": [
      {
        "command": "paredit-redex.forwardSexp",
        "key": "ctrl+alt+f",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/"
      },
      {
        "command": "paredit-redex.backwardSexp",
        "key": "ctrl+alt+b",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/"
      },
      {
        "command": "paredit-redex.backwardUpSexp",
        "key": "ctrl+alt+u",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/"
      },
      {
        "command": "paredit-redex.forwardUpSexp",
        "key": "ctrl+alt+n",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/"
      },
      {
        "command": "paredit-redex.forwardDownSexp",
        "key": "ctrl+alt+d",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/"
      },
      {
        "command": "paredit-redex.backwardDownSexp",
        "key": "ctrl+alt+p",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/"
      },
      {
        "command": "paredit-redex.forwardSlurp",
        "key": "ctrl+right",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.forwardSlurp",
        "key": "ctrl+shift+0",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.forwardBarf",
        "key": "ctrl+left",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.forwardBarf",
        "key": "ctrl+shift+]",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.backwardSlurp",
        "key": "ctrl+alt+left",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.backwardSlurp",
        "key": "ctrl+shift+9",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.backwardBarf",
        "key": "ctrl+alt+right",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.backwardBarf",
        "key": "ctrl+shift+[",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.splice",
        "key": "alt+s",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.raise",
        "key": "alt+r",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.wrapRound",
        "key": "alt+shift+9",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.wrapSquare",
        "key": "alt+[",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.wrapCurly",
        "key": "alt+shift+[",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.killSexp",
        "key": "ctrl+alt+k",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.backwardKillSexp",
        "key": "ctrl+alt+backspace",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.spliceKillingBackward",
        "key": "alt+up",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.spliceKillingForward",
        "key": "alt+down",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.splitSexp",
        "key": "alt+shift+s",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.joinSexps",
        "key": "alt+shift+j",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.transposeSexps",
        "key": "ctrl+alt+t",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.dragForward",
        "key": "ctrl+alt+shift+down",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      },
      {
        "command": "paredit-redex.dragBackward",
        "key": "ctrl+alt+shift+up",
        "when": "editorTextFocus && editorLangId =~ /^(racket|scheme|lisp|commonlisp)$/ && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "lint": "pnpm lint:eslint && pnpm lint:types",
    "lint:eslint": "eslint .",
    "lint:types": "tsc --noEmit",
    "test": "vitest run",
    "test:oracle": "vitest run --config vitest.oracle.mts",
    "test:vscode": "vscode-test",
    "prepare": "husky",
    "package": "vsce package --no-dependencies --allow-unused-files-pattern --allow-missing-repository",
    "test:fixtures": "node test/oracle/generate.mjs",
    "sync:contributions": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-contributions.mjs",
    "icon": "rsvg-convert -w 256 -h 256 icon.svg -o icon.png"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/vscode": "~1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "ovsx": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
